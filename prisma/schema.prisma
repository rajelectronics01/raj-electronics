// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique
  brand         String
  category      String
  price         Float
  originalPrice Float?
  description   String
  images        String[]
  features      String[]
  seoKeywords   String?
  inStock       Boolean     @default(true)
  isFeatured    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]
}

model User {
  id        String    @id @default(cuid())
  phone     String    @unique
  email     String?   @unique
  name      String?
  addresses Address[]
  orders    Order[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String?
  name      String
  phone     String
  street    String
  area      String
  pin       String
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id                String      @id @default(cuid())
  invoiceNo         Int         @unique @default(autoincrement())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  addressId         String
  address           Address     @relation(fields: [addressId], references: [id])
  totalAmount       Float
  paymentMethod     String
  paymentStatus     String      @default("PENDING") // PENDING, PAID, FAILED
  orderStatus       String      @default("PENDING") // PENDING, CONFIRMED, DISPATCHED, DELIVERED, CANCELLED
  razorpayOrderId   String?
  razorpayPaymentId String?
  transactionId     String?     @unique // Unique ID for PhonePe/etc

  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([transactionId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float    // Price per unit at purchase time
}

// Temporary OTP store for customer phone verification
// Records are deleted immediately after successful verification
model OtpVerification {
  phone     String   @id       // 10-digit number used as unique key
  otp       String             // 6-digit code
  expiresAt DateTime           // 5 minutes from creation
  attempts  Int      @default(0) // incremented on wrong guess, max 5
  createdAt DateTime @default(now())
}

model StoreSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model BulkInquiry {
  id               String   @id @default(cuid())
  name             String
  phone            String
  organizationType String   // School, Hospital, etc
  description      String   // Products and Quantity
  status           String   @default("NEW") // NEW, CONTACTED, CLOSED, ARCHIVED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

